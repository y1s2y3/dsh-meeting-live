{
  "name": "dsh-meeting-live",
  "version": "1.2.1",
  "private": false,
  "description": "把会议变成能执行的纪要：录音/录屏自动转写，AI 整理结论、决策与待办，核对后直接进待办清单",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib/**/*.js",
    "resources/**/*.ps1",
    "resources/**/*.png",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "DinosaurYSL",
  "repository": {
    "type": "git",
    "url": "https://github.com/y1s2y3/dsh-meeting-live.git"
  },
  "homepage": "https://github.com/y1s2y3/dsh-meeting-live"
}
